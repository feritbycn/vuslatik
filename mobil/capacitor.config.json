{
  "appId": "com.bilge360.ik",
  "appName": "Bilge360 İK",
  "webDir": "www",
  "server": {
    "url": "https://bilge360.com/ik/ik.php",
    "cleartext": false,
    "allowNavigation": ["bilge360.com", "*.bilge360.com"],
    "errorPath": "hata.html"
  },
  "android": { "allowMixedContent": false },
  "ios": { "contentInset": "automatic", "limitsNavigationsToAppBoundDomains": false },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 800, "backgroundColor": "#4f46e5", "showSpinner": false },
    "FirebaseMessaging": { "presentationOptions": ["badge"] }
  }
}
