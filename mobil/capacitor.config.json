{
  "appId": "com.bilge360.ik",
  "appName": "Bilge360 İK",
  "webDir": "www",
  "server": {
    "url": "https://bilge360.com/ik/giris_cikis.php",
    "cleartext": false,
    "allowNavigation": [
      "bilge360.com",
      "*.bilge360.com"
    ],
    "errorPath": "hata.html"
  },
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "automatic",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#040a1a",
      "showSpinner": false
    },
    "FirebaseMessaging": {
      "presentationOptions": [
        "badge"
      ]
    }
  },
  "appendUserAgent": "Bilge360App"
}
